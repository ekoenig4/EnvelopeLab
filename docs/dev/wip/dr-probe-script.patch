+"""Instrumented dynamic-relaxation probe: the loop of solve(), logging residual, kinetic energy, wrinkle-state changes and where the residual sits. Usage: python dr_probe.py OUT.json MAX_ITERATIONS MESH_MM PROJECT.elproj [--sym]"""
+
+import json
+import math
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import numpy as np
+
+from envelopelab.materials.repository import FabricLibraryRepository
+from envelopelab.project.session import ProjectSession
+from envelopelab.project.simulation import build_solver_model
+from envelopelab.solvers.dynamic_relaxation import _relative, _System
+from envelopelab.solvers.membrane import SLACK, WRINKLED
+from envelopelab.solvers.model import SolverSettings
+
+target = sys.argv[1]
+max_it = int(sys.argv[2]) if len(sys.argv) > 2 else 150_000
+mesh_mm = float(sys.argv[3]) if len(sys.argv) > 3 else 400.0
+s = ProjectSession.open(sys.argv[4] if len(sys.argv) > 4 and not sys.argv[4].startswith("--") else "design.elproj")
+with tempfile.TemporaryDirectory() as tmp:
+    built = build_solver_model(s.design, s.patterns, Path(tmp) / "m", mesh_mm,
+                               FabricLibraryRepository().catalog())
+model = built.model
+mesh = built.build.rest_model.mesh
+if "--sym" in sys.argv:
+    from envelopelab.solvers.model import SymmetryPlane
+    x0 = model.positions
+    print("axis check: mouth centre", np.round(x0[np.unique(mesh.openings["mouth"])].mean(axis=0)[:2], 6))
+    for sid, e in mesh.seam_edges.items():
+        if ":v:" not in sid:
+            continue
+        ns = np.unique(e)
+        th = float(np.arctan2(x0[ns, 1], x0[ns, 0]).mean())
+        spread = float(np.ptp(np.arctan2(x0[ns, 1], x0[ns, 0])))
+        assert spread < 1e-6, (sid, spread)
+        model.symmetry.append(SymmetryPlane(f"meridian {sid}", ns, (-math.sin(th), math.cos(th), 0.0)))
+    print("symmetry planes:", len(model.symmetry))
+settings = SolverSettings(max_iterations=max_it)
+system = _System(model, settings)
+x = system.x_start.copy()
+# node categories for locating the worst residual
+tape_nodes = np.unique(np.concatenate([c.edges.ravel() for c in model.cables])) if model.cables else np.array([], int)
+crown = np.unique(mesh.openings["crown"]) if "crown" in mesh.openings else np.array([], int)
+is_tape = np.zeros(len(x), bool); is_tape[tape_nodes] = True
+is_crown = np.zeros(len(x), bool); is_crown[crown] = True
+
+r, ext, data = system.forces(x)
+r_free = system.project(r)
+mass = system.masses(x, data)
+v = np.zeros_like(x); v_prev = np.zeros_like(x)
+ke_prev = 0.0; fresh = True; resets = 0
+prev_state = data["state"].copy()
+log = []
+t0 = time.time()
+z0, z1 = x[:, 2].min(), x[:, 2].max()
+status = "max_iterations"
+for it in range(1, max_it + 1):
+    accel = r_free / mass[:, None]
+    v = 0.5 * accel if fresh else v + accel
+    fresh = False
+    ke = 0.5 * float((mass[:, None] * v * v).sum())
+    if ke < ke_prev:
+        x = x - 0.5 * v_prev
+        v[:] = 0.0; v_prev[:] = 0.0; ke_prev = 0.0; fresh = True; resets += 1
+        r, ext, data = system.forces(x)
+        mass = system.masses(x, data)
+    else:
+        x = x + v; v_prev = v; ke_prev = ke
+        r, ext, data = system.forces(x)
+    r_free = system.project(r)
+    res = _relative(r_free, ext)
+    if not math.isfinite(res):
+        status = "diverged"; break
+    if res < settings.tolerance:
+        status = "converged"; break
+    if it % 500 == 0:
+        st = data["state"]
+        nodal = np.linalg.norm(r_free, axis=1)
+        k = int(np.argmax(nodal))
+        # share of the residual norm^2 on tape nodes / crown ring / elsewhere
+        tot = float((nodal**2).sum())
+        log.append({
+            "it": it, "res": res, "ke": ke, "resets": resets,
+            "wrinkled": int((st == WRINKLED).sum()), "slack": int((st == SLACK).sum()),
+            "changed": int((st != prev_state).sum()),
+            "worst_z_frac": float((x[k, 2] - z0) / (z1 - z0)),
+            "worst_on_tape": bool(is_tape[k]), "worst_on_crown": bool(is_crown[k]),
+            "share_tape": float((nodal[is_tape]**2).sum() / tot),
+            "share_crown": float((nodal[is_crown]**2).sum() / tot),
+            "t": time.time() - t0,
+        })
+        prev_state = st.copy()
+        if it % 5000 == 0:
+            json.dump({"log": log, "n_tri": int(len(st)), "nodes": int(len(x))}, open(target, "w"))
+            np.save(target.replace(".json", "_x.npy"), x)
+from envelopelab.solvers.dynamic_relaxation import enclosed_volume
+print("height", float(x[:,2].max()-x[:,2].min()), "width", float(2*np.hypot(x[:,0],x[:,1]).max()))
+json.dump({"log": log, "status": status, "iterations": it, "residual": res, "height": float(x[:,2].max()-x[:,2].min()), "width": float(2*np.hypot(x[:,0],x[:,1]).max()),
+           "n_tri": int(len(data["state"])), "nodes": int(len(x))}, open(target, "w"))
+np.save(target.replace(".json", "_x.npy"), x)
+print(status, it, res)
